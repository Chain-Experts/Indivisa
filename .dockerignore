# Keep build contexts small and free of anything private.
.git
private/
CLAUDE.md
CLAUDE-backup.md
node_modules
ui/node_modules
# ui/dist is needed by judge/web.Dockerfile when UI_SOURCE=prebuilt
infra/*/demo/
infra/*/log/
infra/*/public/
infra/*/participants-with-parties.json
infra/*/participants.json
infra/*/ui.json
infra/localnet/log/
daml/*/.daml/dependencies
!judge/.cache/daml-script.jar

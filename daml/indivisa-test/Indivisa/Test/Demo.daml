-- | The demo: seat a realistic holder base once, then run the paying agent's
-- day as many times as the recording needs, including the deliberate
-- failure.
--
-- Two scripts, both driven by input files so ops can run them from a shell
-- and the UI can read their output:
--
--   demo_seat     DemoSeatArgs -> DemoSeat
--     parties, the cash, the instrument, positions, onboarding (the one
--     click per holder, shown once), the announcement, the record-date
--     snapshot and the on-ledger schedule. Emits everything the run and the
--     four panes need. Run once per demo instance; pick a fresh `tag`.
--
--   demo_attempt  DemoAttemptArgs -> DemoOutcome
--     the paying agent's day for that seat: the run (created on the first
--     attempt, reused after), whatever allocations are still missing, one
--     settlement. `withhold = 1` leaves the last holder without a receipt
--     allocation, so the batch is refused and a SettlementRejected record
--     is written; `withhold = 0` afterwards creates the one missing receipt
--     and settles. That is the recording: rejected, then 250/250.
--
--   dpm script --dar .daml/dist/indivisa-test-0.1.0.dar \
--     --script-name Indivisa.Test.Demo:demo_seat --input-file seat-args.json \
--     --output-file seat.json --participant-config <participants>
--
-- Names and sizes are synthetic and say so in the README. No Alice, Bob or
-- Charlie.
module Indivisa.Test.Demo where

import DA.Assert ((===))
import DA.Date (date, Month(..))
import DA.Foldable (forA_)
import DA.List ((!!))
import DA.Set qualified as Set
import DA.Text qualified as T
import DA.Time (convertRelTimeToMicroseconds, subTime)

import Daml.Script

import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.TokenStandard.Utils (basicAccount)
import Splice.Testing.Tokens.TestTokenV2 qualified as TestTokenV2

import Indivisa.Types
import Indivisa.Model.Register
import Indivisa.Model.Event
import Indivisa.Model.Entitlement
import Indivisa.Model.Payment
import Indivisa.Model.Distribution
import Indivisa.Test.Agent
import Indivisa.Test.Fixtures

-- ---------------------------------------------------------------------------
-- A realistic holder base, deterministically
-- ---------------------------------------------------------------------------


  , "Priya", "Mateo", "Hanna", "Yusuf", "Elena", "Samuel", "Noor", "Felix"
  , "Amara", "Jonas", "Sofia", "Rafael", "Leila", "Viktor", "Chloe", "Arjun"
  , "Nadia", "Oscar", "Zara", "Emil", "Irene", "Kwame", "Beatriz", "Henrik"
  , "Farah", "Louis", "Mira", "Tariq", "Greta", "Idris", "Clara", "Bruno" ]

surnames : [Text]
surnames =
  [ "Lindqvist", "Haddad", "Okafor", "Nowak", "Tanaka", "Moreau", "Silva", "Brennan"
  , "Kowalski", "Rahman", "Berg", "Castillo", "Fischer", "Nakamura", "Osei", "Petrov"
  , "Dubois", "Andersen", "Costa", "Ivanova", "Mensah", "Larsson", "Rossi", "Yilmaz"
  , "Kaur", "Schmidt", "Almeida", "Novak", "Sato", "Delgado", "Hughes", "Bakker"
  , "Vargas", "Eriksson", "Nasser", "Kimura", "Ferreira", "Laine", "Walsh", "Adeyemi" ]

institutions : [Text]
institutions =
  [ "Pine-Pension-Fund", "Aster-Capital", "Harbour-Life-Assurance", "Meridian-Endowment"
  , "Northlake-Insurance", "Sable-Asset-Management", "Cedar-Retirement-Trust", "Orion-Family-Office"
  , "Quill-Income-Fund", "Granite-Mutual", "Willow-Foundation", "Lumen-Reinsurance"
  , "Tidewater-Savings", "Alder-Wealth-Partners", "Summit-Provident", "Vega-Treasury"
  , "Halcyon-Bond-Fund", "Kestrel-Capital", "Marlow-Trust", "Oakridge-Pension"
  , "Solace-Annuity", "Beacon-Credit-Union", "Fjord-Investments", "Ironwood-Endowment"
  , "Juniper-Life", "Cobalt-Fixed-Income", "Ridge-University-Endowment", "Atlas-Sovereign-Fund"
  , "Ember-Municipal-Fund", "Linden-Savings-Bank" ]

-- | Holder i's name as a party hint (no spaces). Every fourth holder is an
-- institution. Deterministic, so a seat is reproducible, and distinct for
-- every i below 1,600: the surname index shifts by 11 per pass over the
-- first names (11 and 40 are coprime), and an institution past the thirty
-- names gets a fund number. The first version paired both name lists by
-- the same index and produced seven Arjun Tanakas in 250 holders.
holderName : Int -> Text
holderName i
  | i % 4 == 0 =
      let k = i / 4
      in institutions !! (k % length institutions) <> fundNumber (k / length institutions)
  | otherwise  =
      let pass = i / length firstNames
      in firstNames !! (i % length firstNames) <> "-" <> surnames !! ((i * 7 + 3 + pass * 11) % length surnames)

-- | "", "-II", "-III", ... for the second, third, ... fund of the same name.
fundNumber : Int -> Text
fundNumber 0 = ""
fundNumber n = "-" <> ["II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"] !! ((n - 1) % 9)

-- | Names are distinct up to the largest seat we would ever record.
demo_namesUnique : Script ()
demo_namesUnique = do
  let names = map holderName [0 .. 999]
  Set.size (Set.fromList names) === length names

-- | Position sizes in units of 1,000 face value. Heavy-tailed, as bond
-- registers are: most holders small, a few large, institutions ten times
-- larger. Deterministic in i.
holderQuantity : Int -> Decimal
holderQuantity i =
  let sizes = [1.0, 1.0, 2.0, 2.0, 3.0, 3.0, 5.0, 5.0, 8.0, 10.0, 12.0, 15.0, 20.0, 25.0, 30.0, 40.0, 50.0, 75.0, 100.0, 150.0, 200.0, 300.0, 500.0]
      base = sizes !! ((i * 7919) % length sizes)
  in if i % 4 == 0 then base * 10.0 else base

-- ---------------------------------------------------------------------------
-- Seat
-- ---------------------------------------------------------------------------

data DemoSeatArgs = DemoSeatArgs
  with
    topology : Topology
    holders  : Int
    tag      : Text
      -- ^ Suffix on every party name so a demo can be seated more than once
      -- on the same LocalNet. On the IDE ledger anything will do.
    user     : Optional Text
      -- ^ On a network with authentication, the ledger user the runner
      -- submits as, granted rights on every party the seat allocates.
  deriving (Eq, Show)

-- | Everything the run and the panes need, as the seat left it.
data DemoSeat = DemoSeat
  with
    topology      : Topology
    tag           : Text
    registry      : Party
    issuer        : Party
    payingAgent   : Party
    holders       : [Party]
    rulesCid      : ContractId TestTokenV2.TokenRules
    instrumentCid : ContractId Instrument
    snapshotCid   : ContractId RegisterSnapshot
    scheduleCid   : ContractId EntitlementSchedule
    agreements    : [(Party, ContractId PaymentAgreement)]
    isin          : Text
    runId         : Text
    legs          : Int
    total         : Decimal
  deriving (Eq, Show)

demoIsin : Text
demoIsin = "XS2999912340"

-- | Announce a coupon, freeze the register on its record date, derive the
-- schedule, create the run, allocate and settle. One coupon, start to finish,
-- and the total it paid.
--
-- This exists because a paying agent's book is mostly **finished** work. A
-- register holding one live coupon and nothing else looks like a test
-- harness; a register with a payment history looks like a job. Every row it
-- creates is a real settlement with a real receipt and a real update id, not
-- a decoration: open one in the console and the evidence is there.
--
-- **It funds itself with exactly what it pays**, which keeps the seat's
-- arithmetic checkable: the agent is left holding its float and nothing else,
-- which is what `demo_smoke` asserts at the end.
--
-- `positionCids` is a parameter rather than "the whole register" on purpose.
-- A record-date snapshot captures whoever held the bond **then**, so a holder
-- who bought in later is legitimately absent from an earlier coupon. That is
-- what makes the demo bond's own history settleable at all: its newest holder
-- has given the agent no settlement instructions yet, so a coupon that
-- included them could not settle, and a coupon from before they arrived can.
paidCoupon
  :  Party -> Party -> Party -> Cash
  -> ContractId Instrument -> Text
  -> [ContractId Position]
  -> [(Party, ContractId PaymentAgreement)]
  -> Decimal -> Date -> Date
  -> Script Decimal
paidCoupon registry issuer payingAgent cash instrumentCid isin positionCids agreements rate recordDate paymentDate = do
  actionCid <- submit issuer $ createCmd CorporateAction with
    issuer
    payingAgent
    isin
    kind = Coupon
    currency = "USD"
    amountPerUnit = rate
    recordDate
    paymentDate
  awaitVisible payingAgent actionCid
  snapshotCid <- submit payingAgent $ exerciseCmd instrumentCid Instrument_Snapshot with
    recordDate
    positionCids
  scheduleCid <- submit payingAgent $ exerciseCmd actionCid CorporateAction_Entitle with
    snapshotCid
    policy = LargestRemainder
  Some schedule <- queryContractId payingAgent scheduleCid
  let run = runFromSchedule registry scheduleCid schedule
  fund cash payingAgent schedule.total
  runCid <- submit payingAgent $ createCmd run
  sendCid <- allocateSend payingAgent cash run
  receiptCids <- allocateReceipts payingAgent cash run agreements
  _ <- settle payingAgent cash runCid (sendCid :: receiptCids)
  pure schedule.total

demo_seat : DemoSeatArgs -> Script DemoSeat
demo_seat args = do
  let n = args.holders
      tag = args.tag
      named name participant = allocateOnAs args.topology args.user (name <> "-" <> tag) participant

  -- Parties. The registry on its own node, issuer and agent together, the
  -- holders spread over the three holder nodes.
  registry    <- named "USD-Registry" "registry"
  issuer      <- named "Northwind-Rail" "agent"
  payingAgent <- named "Meridian-Paying-Agent" "agent"
  holders     <- forA [1..n] $ \i -> named (holderName i) (holderParticipant i)

  -- The cash: a V2 instrument administered by the registry.
  rulesCid <- submit registry $ createCmd TestTokenV2.TokenRules with admin = registry
  cash <- cashFor registry rulesCid

  -- The register. The paying agent is the registrar.
  instrumentCid <- submit payingAgent $ createCmd Instrument with
    registrar = payingAgent
    issuer
    isin = demoIsin
    name = "Northwind Rail 4.375% 2031"
    currency = "USD"
    denomination = 1000.0
    couponRate = 0.04375
    maturity = date 2031 Dec 1
  positionCids <- forA (zip [1..n] holders) $ \(i, holder) ->
    submit payingAgent $ createCmd Position with
      registrar = payingAgent
      holder
      isin = demoIsin
      quantity = holderQuantity i

  -- Settlement instructions: the one thing a holder ever provides, and the
  -- last holder has not provided them yet.
  --
  -- The demo used to make the first run fail by having the agent skip one
  -- holder's receipt allocation. That is not a thing that happens: an agent's
  -- software does not forget. **Missing settlement instructions are one of the
  -- commonest reasons a real payment fails** - a holder new to this agent, a
  -- bank account that changed, details that went stale - so that is what this
  -- seat arms instead. The fix is the holder providing them, on their own
  -- page, which is also the only thing a holder ever does.
  let signed = take (n - 1) holders
      waiting = holders !! (n - 1)
  agreements <- onboardAll payingAgent cash signed
  _ <- submit payingAgent $ createCmd PaymentProposal with
    payingAgent
    holder = waiting
    account = basicAccount waiting
    instrument = cash.instrument

  -- The announcement: a semi-annual coupon, 4.375% on 1,000 -> 21.875 per
  -- unit, so the cents have somewhere to go and the rounding is visible.
  let recordDate = date 2027 Nov 15
      paymentDate = date 2027 Dec 1
  actionCid <- submit issuer $ createCmd CorporateAction with
    issuer
    payingAgent
    isin = demoIsin
    kind = Coupon
    currency = "USD"
    amountPerUnit = 21.875
    recordDate
    paymentDate
  awaitVisible payingAgent actionCid

  -- Record date: freeze, entitle.
  snapshotCid <- submit payingAgent $ exerciseCmd instrumentCid Instrument_Snapshot with
    recordDate
    positionCids
  scheduleCid <- submit payingAgent $ exerciseCmd actionCid CorporateAction_Entitle with
    snapshotCid
    policy = LargestRemainder
  Some schedule <- queryContractId payingAgent scheduleCid

  -- The NEXT coupon on the same bond, entitled and deliberately left without
  -- a run.
  --
  -- This is what lets one stack carry both demonstrations. Until 8 October the
  -- governed path needed a stack of its own, because a DistributionRun is
  -- created once per run id and an approver cannot be added afterwards, so a
  -- seat that created the run had already decided the answer. INDIVISA_GOVERNED
  -- existed only to stop the seat before that point. Now the page creates runs
  -- itself, with or without an approver, and a run id is derived per bond and
  -- payment date - so the second coupon is simply a second run id, and the
  -- operator decides at the panel which way it is released.
  --
  -- A bond paying semi-annually, so the next payment date is six months on.
  -- Entitled but not prepared, which is exactly the state the agent's panel
  -- calls "the run is the one step left".
  --
  -- **Every holder has settlement instructions by the time this one is
  -- worked**, because working it comes after the first coupon, where the last
  -- holder provides them. That matters: on a governed run the ask button is
  -- disabled while anything is outstanding (5 October), since the approvers
  -- decide whether a payment goes out and should not be asked to approve one
  -- that cannot execute.
  let recordDate2 = date 2028 May 15
      paymentDate2 = date 2028 Jun 1
  action2Cid <- submit issuer $ createCmd CorporateAction with
    issuer
    payingAgent
    isin = demoIsin
    kind = Coupon
    currency = "USD"
    amountPerUnit = 21.875
    recordDate = recordDate2
    paymentDate = paymentDate2
  awaitVisible payingAgent action2Cid
  -- Instrument_Snapshot is nonconsuming, so the same instrument and the same
  -- positions serve both record dates. The register is a plain Daml template
  -- and settling a coupon does not touch it.
  snapshot2Cid <- submit payingAgent $ exerciseCmd instrumentCid Instrument_Snapshot with
    recordDate = recordDate2
    positionCids
  schedule2Cid <- submit payingAgent $ exerciseCmd action2Cid CorporateAction_Entitle with
    snapshotCid = snapshot2Cid
    policy = LargestRemainder
  Some schedule2 <- queryContractId payingAgent schedule2Cid

  -- A second bond, and its coupon is already paid.
  --
  -- The console used to open on a register of exactly one instrument, so a
  -- bond selector would have had nothing to select. A real paying agent runs
  -- a book: several instruments, each at a different stage, and most of them
  -- finished.
  --
  -- **Its holders are its own two**, not the first bond's. That is both more
  -- realistic, since a register is holders of overlapping but different
  -- instruments, and necessary: every holder of the first bond is paid by the
  -- demo, and the demo's whole visual is a card going from 0.00 to its amount.
  -- Paying them here first would have started them with cash. Two extra
  -- parties is the only cost, and parties are the slow part of seating.
  let pentlandIsin = "XS2888845670"
  bHolders <- forA [1, 2] $ \i ->
    named (["Pentland-Trust", "Calder-Pension"] !! (i - 1)) (holderParticipant i)
  bAgreements <- onboardAll payingAgent cash bHolders
  bInstrumentCid <- submit payingAgent $ createCmd Instrument with
    registrar = payingAgent
    issuer
    isin = pentlandIsin
    name = "Pentland Water 3.25% 2029"
    currency = "USD"
    denomination = 1000.0
    couponRate = 0.0325
    maturity = date 2029 Jun 30
  bPositionCids <- forA (zip [1, 2] bHolders) $ \(i, holder) ->
    submit payingAgent $ createCmd Position with
      registrar = payingAgent
      holder
      isin = pentlandIsin
      quantity = if i == 1 then 400.0 else 125.0
  -- Its coupon, paid, so the register opens with something finished on it.
  _ <- paidCoupon registry issuer payingAgent cash bInstrumentCid pentlandIsin
         bPositionCids bAgreements 16.25 (date 2027 May 15) (date 2027 Jun 1)

  -- A second coupon on the second bond, so the register shows a history
  -- rather than a single row per instrument.
  --
  -- **The demo bond gets no paid history, and that is deliberate.** It was
  -- tried on 9 October and `demo_smoke` caught it immediately: paying this
  -- bond's holders before the demo runs leaves them holding cash, and a card
  -- going from 0.00 to its amount is the shot the whole film is built on. The
  -- comment above this one had already said so about the second bond's
  -- holders; the fill has to come from instruments whose holders the demo
  -- never pays. **A register row is cheap, a holder's starting balance is
  -- not.**
  _ <- paidCoupon registry issuer payingAgent cash bInstrumentCid pentlandIsin
         bPositionCids bAgreements 16.25 (date 2026 Nov 15) (date 2026 Dec 1)

  -- A third instrument, with two holders of its own: one coupon paid and one
  -- only announced.
  --
  -- The announced one is the state the agent's own panel exists for - the
  -- issuer has declared the terms and nobody has frozen the register yet - and
  -- the register had no row in that state before. It is deliberately NOT on
  -- the demo bond: an un-entitled announcement there would take over the
  -- agent's panel and hide the governed coupon's release choice, which is the
  -- one control the second half of the walkthrough is about.
  let caledonIsin = "XS3041559820"
  cHolders <- forA [1, 2] $ \i ->
    named (["Rowan-Mutual", "Thameside-Life"] !! (i - 1)) (holderParticipant (i + 1))
  cAgreements <- onboardAll payingAgent cash cHolders
  cInstrumentCid <- submit payingAgent $ createCmd Instrument with
    registrar = payingAgent
    issuer
    isin = caledonIsin
    name = "Caledon Energy 5.125% 2033"
    currency = "USD"
    denomination = 1000.0
    couponRate = 0.05125
    maturity = date 2033 Mar 1
  cPositionCids <- forA (zip [1, 2] cHolders) $ \(i, holder) ->
    submit payingAgent $ createCmd Position with
      registrar = payingAgent
      holder
      isin = caledonIsin
      quantity = if i == 1 then 250.0 else 90.0
  _ <- paidCoupon registry issuer payingAgent cash cInstrumentCid caledonIsin
         cPositionCids cAgreements 25.625 (date 2027 Feb 15) (date 2027 Mar 1)
  -- Announced only: no snapshot, no schedule, no run, nothing funded.
  _ <- submit issuer $ createCmd CorporateAction with
    issuer
    payingAgent
    isin = caledonIsin
    kind = Coupon
    currency = "USD"
    amountPerUnit = 25.625
    recordDate = date 2027 Aug 15
    paymentDate = date 2027 Sep 1

  -- Fund the agent for the two coupons this seat leaves WORKABLE, plus a
  -- float. Everything already paid funded itself with exactly what it paid,
  -- so the float is the only surplus and `demo_smoke` asserts it at the end.
  -- The seat once funded one run's worth and the agent ran out mid-demo
  -- (1 October), so this is counted rather than estimated. SIMULATED cash.
  fund cash payingAgent (schedule.total + schedule2.total + 10000.0)

  let run = runFromSchedule registry scheduleCid schedule
      seat = DemoSeat with
        topology = args.topology
        tag
        registry
        issuer
        payingAgent
        holders
        rulesCid
        instrumentCid
        snapshotCid
        scheduleCid
        agreements
        isin = demoIsin
        runId = run.runId
        legs = length schedule.entries
        total = schedule.total
  debug ("seated " <> show n <> " holders; schedule total " <> show schedule.total <> " over " <> show (length schedule.entries) <> " legs; run id " <> run.runId)
  pure seat

-- ---------------------------------------------------------------------------
-- Attempt
-- ---------------------------------------------------------------------------

data DemoAttemptArgs = DemoAttemptArgs
  with
    seat     : DemoSeat
    withhold : Int
      -- ^ Leave this many holders (from the end) without a receipt
      -- allocation. 1 arms the deliberate failure; 0 completes the run.
    approver : Optional Party
      -- ^ A party whose authority the settlement needs besides the agent's
      -- (the BitSafe demo: a decentralised party). Set when the run is
      -- created, on the first attempt; None is the main demo.
  deriving (Eq, Show)

data DemoOutcome
  = Settled
      with
        receiptCid  : ContractId DistributionReceipt
        legsSettled : Int
        total       : Decimal
        settleMs    : Int
  | Rejected
      with
        rejectedCid   : ContractId SettlementRejected
        legsRequested : Int
        reason        : Text
  deriving (Eq, Show)

-- | What the allocation phase leaves ready for the button. The UI settles
-- from this: the run, every allocation, and the factory to disclose.
data DemoPrepared = DemoPrepared
  with
    runCid         : ContractId DistributionRun
    allocationCids : [ContractId V2.Allocation]
    rulesCid       : ContractId TestTokenV2.TokenRules
    registry       : Party
    payingAgent    : Party
    runId          : Text
    legs           : Int
    total          : Decimal
    withheld       : [Party]
  deriving (Eq, Show)

-- | The allocation phase only: find or create the run, create whatever
-- allocations are still missing (minus the withheld ones), stop before the
-- settle. This is what runs before the button in the UI is pressed; the
-- button submits Run_Settle over the JSON Ledger API.
demo_prepare : DemoAttemptArgs -> Script DemoPrepared
demo_prepare args = do
  let seat = args.seat
      agent = seat.payingAgent
  cash <- cashFor seat.registry seat.rulesCid
  Some schedule <- queryContractId agent seat.scheduleCid

  -- The run: created on the first attempt, found on the next.
  existingRuns <- query @DistributionRun agent
  runCid <- case [ cid | (cid, r) <- existingRuns, r.runId == seat.runId ] of
    cid :: _ -> pure cid
    [] -> submit agent $ createCmd (runFromSchedule seat.registry seat.scheduleCid schedule) with approver = args.approver
  Some run <- queryContractId agent runCid

  -- Allocations already made for this run, by authorizing account.
  existing <- queryInterface @V2.Allocation agent
  let forThisRun = [ (cid, v) | (cid, Some v) <- existing, v.settlement.id == run.runId ]
      allocated = Set.fromList [ v.allocation.authorizer | (_, v) <- forThisRun ]
      existingCids = map fst forThisRun

  -- The send allocation, if it is not there yet.
  sendCids <-
    if Set.member run.agentAccount allocated
      then pure []
      else (:: []) <$> allocateSend agent cash run

  -- Receipt allocations for holders who have none, minus the withheld ones.
  --
  -- The agreements are read from the ledger rather than from the seat record,
  -- because a holder can provide settlement instructions after the seat was
  -- written, which is exactly what the demo now turns on. The page's
  -- `allocateMissing` does the same for the same reason.
  -- Only holders this run actually pays. An agreement is about the CASH
  -- instrument, which every bond shares, so a holder of another bond has one
  -- too and would otherwise get an allocation carrying no legs, which the
  -- token refuses outright.
  live <- query @PaymentAgreement agent
  let recipients = Set.fromList (map (.recipient) run.legs)
      onLedger =
        [ (a.holder, cid)
        | (cid, a) <- live
        , a.instrument == run.instrument
        , Set.member a.holder recipients
        ]
      wanted = [ (h, a) | (h, a) <- onLedger, not (Set.member (basicAccount h) allocated) ]
      toCreate = take (length wanted - args.withhold) wanted
      withheld = drop (length wanted - args.withhold) wanted
  receiptCids <- allocateReceipts agent cash run toCreate
  forA_ withheld $ \(h, _) -> debug ("withholding the receipt allocation of " <> show h)
  pure DemoPrepared with
    runCid
    allocationCids = existingCids ++ sendCids ++ receiptCids
    rulesCid = seat.rulesCid
    registry = seat.registry
    payingAgent = agent
    runId = run.runId
    legs = length run.legs
    total = runTotal run
    withheld = map fst withheld

-- | Prepare, then settle in the script itself. What the smoke test and the
-- shell demo use; the UI uses demo_prepare and presses the button itself.
demo_attempt : DemoAttemptArgs -> Script DemoOutcome
demo_attempt args = do
  prepared <- demo_prepare args
  let agent = prepared.payingAgent
      runCid = prepared.runCid
  cash <- cashFor prepared.registry prepared.rulesCid
  Some run <- queryContractId agent runCid

  -- One transaction.
  t0 <- getTime
  r <- trySettle agent cash runCid prepared.allocationCids
  t1 <- getTime
  case r of
    Right (receiptCid, result) -> do
      let ms = truncate (intToDecimal (convertRelTimeToMicroseconds (subTime t1 t0)) / 1000.0)
      debug ("SETTLED " <> show (length result.allocationSettleResults - 1) <> " legs in " <> show ms <> " ms; receipt " <> show receiptCid)
      pure Settled with
        receiptCid
        legsSettled = length run.legs
        total = runTotal run
        settleMs = ms
    Left err -> do
      let reason = T.take 2000 (errorText err)
      rejectedCid <- submit agent $ createCmd SettlementRejected with
        payingAgent = agent
        runId = run.runId
        attemptedAt = t0
        legsRequested = length run.legs
        reason
      debug ("REJECTED " <> show (length run.legs) <> " legs requested, 0 executed: " <> T.take 200 reason)
      pure Rejected with
        rejectedCid
        legsRequested = length run.legs
        reason

-- ---------------------------------------------------------------------------
-- The recording, on the IDE ledger, as a test
-- ---------------------------------------------------------------------------

demo_smoke : Script ()
demo_smoke = do
  seat <- demo_seat DemoSeatArgs with topology = Ide; holders = 12; tag = "smoke"; user = None
  seat.legs === 12
  Some schedule <- queryContractId seat.payingAgent seat.scheduleCid
  sum (map (.amount) schedule.entries) === schedule.total
  cash <- cashFor seat.registry seat.rulesCid

  -- Run two, but first: one holder has given no settlement instructions, so
  -- the agent cannot authorise their side and nobody is paid.
  first <- demo_attempt DemoAttemptArgs with seat; withhold = 0; approver = None
  case first of
    Rejected {..} -> do
      assertMsg "reason names the missing authorisation" ("missing authorizations" `T.isInfixOf` reason)
      legsRequested === 12
    Settled {} -> fail "settled with one holder's settlement instructions missing"
  forA_ seat.holders $ \h -> awaitBalance cash h 0.0
  rejected <- query @SettlementRejected seat.payingAgent
  length rejected === 1

  -- The holder provides them. One submission, by the holder, once in their
  -- life: this is the only command a holder ever sends.
  let waiting = seat.holders !! (length seat.holders - 1)
  proposals <- query @PaymentProposal waiting
  case proposals of
    (cid, _) :: _ -> do
      _ <- submit waiting $ exerciseCmd cid Accept
      pure ()
    [] -> fail "the waiting holder had no settlement instructions to provide"

  -- Then the retry: the last receipt is created, and everyone is paid.
  second <- demo_attempt DemoAttemptArgs with seat; withhold = 0; approver = None
  case second of
    Settled {..} -> do
      legsSettled === 12
      total === schedule.total
    Rejected {..} -> fail ("expected settlement, got: " <> reason)
  forA_ schedule.entries $ \e -> awaitBalance cash e.holder e.amount

  -- The SECOND coupon on the same bond, which is what lets one stack carry
  -- both demonstrations. The seat entitled it and deliberately left it
  -- without a run; this is the page's work, done here as a script.
  --
  -- The schedule is found by payment date rather than carried in the seat,
  -- which is the same thing the page has to do: a bond has several coupons
  -- and `EntitlementSchedule` for this ISIN is now more than one contract.
  live <- query @EntitlementSchedule seat.payingAgent
  let mine = [ (cid, s) | (cid, s) <- live, s.isin == seat.isin ]
      next = maximumBy (\a b -> compare (snd a).paymentDate (snd b).paymentDate) mine
  (schedule2Cid, schedule2) <- pure next
  assertMsg "the second coupon is a later payment date than the first"
    (schedule2.paymentDate > schedule.paymentDate)
  -- Every holder has settlement instructions by now, including the one who
  -- provided them above, so this coupon needs nothing from anybody.
  agreements <- query @PaymentAgreement seat.payingAgent
  let forThisCash = [ (a.holder, cid) | (cid, a) <- agreements, a.instrument == cash.instrument ]
      run2 = runFromSchedule seat.registry schedule2Cid schedule2
      recipients = map (.recipient) run2.legs
      forThisRun = [ (h, cid) | (h, cid) <- forThisCash, h `elem` recipients ]
  length forThisRun === 12
  assertMsg "the second coupon has a run id of its own" (run2.runId /= seat.runId)
  run2Cid <- submit seat.payingAgent $ createCmd run2
  send2 <- allocateSend seat.payingAgent cash run2
  receipts2 <- allocateReceipts seat.payingAgent cash run2 forThisRun
  (_, _) <- settle seat.payingAgent cash run2Cid (send2 :: receipts2)
  -- Paid twice, so each holder now holds both coupons.
  forA_ schedule.entries $ \e -> awaitBalance cash e.holder (e.amount * 2.0)

  -- The float, and only the float: the seat funds the agent for every coupon
  -- it leaves workable, and all of them have now settled.
  awaitBalance cash seat.payingAgent 10000.0

  -- Nothing about the run reached a holder's view.
  forA_ seat.holders $ \h -> do
    query @EntitlementSchedule h >>= (=== [])
    query @DistributionRun h >>= (=== [])
    query @SettlementRejected h >>= (=== [])

-- | Top up the paying agent, so a seat can run a second coupon.
--
-- The seat funds the agent once, with exactly what the run costs. Settling
-- spends it, and a second `demo_prepare` on the same tag then dies with
-- "Not enough funds for allocation" - which is correct and unhelpful, since
-- the obvious next move, seating afresh, allocates a NEW paying agent party.
-- On a governed network that party has to be admitted to the governance
-- rules before it may propose anything, and admitting it needs the other
-- approvers. So a rerun that should cost nothing costs a round trip to
-- another organisation.
--
-- Funding the existing agent avoids all of that: the party is unchanged, its
-- admission still stands, and the run is the same shape. Nothing proven
-- depends on how the agent was funded (see `fund`).
data DemoFundArgs = DemoFundArgs
  with
    seat   : DemoSeat
    amount : Decimal
  deriving (Eq, Show)

demo_fund : DemoFundArgs -> Script Decimal
demo_fund args = do
  let s = args.seat
  cash <- cashFor s.registry s.rulesCid
  fund cash s.payingAgent args.amount
  pure args.amount

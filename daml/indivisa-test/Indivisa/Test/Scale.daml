-- | Proof 5, script form: the full onboard -> allocate -> settle path for N
-- holders, one committed send allocation carrying all N legs and N receipt
-- allocations, settled in one SettleBatch.
--
-- What this proves and what it does not. The IDE ledger has no transaction
-- size limit and no network, so it cannot find the ceiling. It does show
-- whether the settle path stays linear in N (the standard's utils build sets
-- and check uniqueness over every leg), and the same script runs unchanged
-- against a real participant over gRPC, where the ceiling, the bytes and the
-- latency are read off the participant. See docs/benchmark.md.
--
-- IDE ledger, one size (static time; see Fixtures):
--
--   dpm script --dar .daml/dist/indivisa-test-0.1.0.dar \
--     --script-name Indivisa.Test.Scale:scale --input-file n.json \
--     --ide-ledger --static-time
--
-- LocalNet (infra/localnet), one size:
--
--   dpm script --dar .daml/dist/indivisa-test-0.1.0.dar \
--     --script-name Indivisa.Test.Scale:scaleWith --input-file args.json \
--     --participant-config ../../infra/localnet/participants.json
--
-- n.json holds the holder count; args.json holds ScaleArgs. Give the runner
-- JAVA_TOOL_OPTIONS=-Xss64m above ~1000 holders. The fixed sizes below run
-- under `dpm test`; keep them small so the proofs stay quick.
module Indivisa.Test.Scale where

import DA.Assert ((===))
import DA.List ((!!))
import DA.Text qualified as T
import DA.Time (convertRelTimeToMicroseconds, subTime)

import Daml.Script

import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.TokenStandard.Utils (basicAccount)
import Splice.Testing.Tokens.TestTokenV2 qualified as TestTokenV2

import Indivisa.Types
import Indivisa.Model.Distribution
import Indivisa.Test.Agent
import Indivisa.Test.Fixtures

-- | What one run tells us. Wall time is measured outside the script.
data ScaleResult = ScaleResult
  with
    holders            : Int
    legsSettled        : Int
    allocationsSettled : Int
    total              : Decimal
  deriving (Eq, Show)

-- | N holders, N legs, amounts 100 + i so no two legs are alike and the
-- total is exact.
scaleLegs : [Party] -> [PaymentLeg]
scaleLegs holders = scaleLegsN (length holders) holders

-- | N legs over the holders given, cycling if there are fewer holders than
-- legs. One leg per holder is the realistic shape of a coupon run and what
-- every benchmark row up to 1,000 used. More legs than holders is the
-- ceiling test: it grows the transaction without waiting for a topology
-- transaction per party (about five seconds each). Both are legal, and the
-- difference is recorded in docs/benchmark.md: with M holders and N legs
-- the batch is M+1 allocations rather than N+1, so the same leg count
-- carries fewer allocations.
scaleLegsN : Int -> [Party] -> [PaymentLeg]
scaleLegsN n holders =
  [ PaymentLeg with
      legId = "leg-" <> pad i
      recipient = holders !! ((i - 1) % length holders)
      amount = 100.0 + intToDecimal i
  | i <- [1..n]
  ]
  where
    pad i = let s = show i in T.implode (replicate (max 0 (5 - T.length s)) "0") <> s

-- | What the allocation phase leaves behind for the settle.
data Prepared = Prepared
  with
    cast           : Cast
    cash           : Cash
    runCid         : ContractId DistributionRun
    allocationCids : [ContractId V2.Allocation]
    holders        : [Party]
    legs           : [PaymentLeg]
    total          : Decimal

-- | The same, as the runner can write it with --output-file: `Cash` carries
-- a disclosure with a type representation, which has no JSON form (the
-- runner fails "Illegal TypeRep in Value" on it, 18 Sep). This is the
-- input of the JSON API settle client, ui/scripts/settle.ts.
data PreparedOut = PreparedOut
  with
    registry       : Party
    payingAgent    : Party
    rulesCid       : ContractId TestTokenV2.TokenRules
    runCid         : ContractId DistributionRun
    allocationCids : [ContractId V2.Allocation]
    legs           : Int
    total          : Decimal
  deriving (Eq, Show)

-- | The runner's input: which ledger and how many holders. As JSON for
-- --input-file: {"topology": "LocalNet", "holders": 500}  (Topology is an enum)
data ScaleArgs = ScaleArgs
  with
    topology : Topology
    holders  : Int
    user     : Optional Text
      -- ^ See DemoSeatArgs.user.
    legs     : Optional Int
      -- ^ How many legs to settle. None means one per holder, the realistic
      -- shape. A number larger than `holders` spreads the legs over them and
      -- is how the ceiling was pushed past the holder pool; see scaleLegsN.
  deriving (Eq, Show)

-- | Everything up to the settle: parties, funding, onboarding, the run and
-- all allocations. Returns what settle needs. Timed on its own so that
-- (scaleWith args) minus (scaleAllocateOnlyWith args) is the cost of the one
-- transaction.
scaleAllocateOnlyWith : ScaleArgs -> Script Prepared
scaleAllocateOnlyWith args = do
  let n = args.holders
  (cast, cash) <- setupAs args.topology args.user
  holders <- scaleHoldersAs args.topology args.user n
  let legs = scaleLegsN (optional n identity args.legs) holders
      total = sum (map (.amount) legs)
  fund cash cast.payingAgent (total + 1000.0)

  -- Onboarding: N proposals, N acceptances. Shown once in the demo.
  agreements <- onboardAll cast.payingAgent cash holders

  -- The run.
  (runCid, run) <- createRun cast cash ("SCALE-" <> show n) legs
  runTotal run === total

  -- Allocation phase: 1 + N commands.
  sendCid <- allocateSend cast.payingAgent cash run
  receiptCids <- allocateReceipts cast.payingAgent cash run agreements
  lockedBalance cash cast.payingAgent >>= (=== total)
  pure Prepared with
    cast
    cash
    runCid
    allocationCids = sendCid :: receiptCids
    holders
    legs
    total

-- | The prepare for the JSON API benchmark (infra/settle.ps1): everything
-- up to the settle, emitted in a form the runner can write out.
scalePrepare : ScaleArgs -> Script PreparedOut
scalePrepare args = do
  Prepared {..} <- scaleAllocateOnlyWith args
  pure PreparedOut with
    registry = cast.registry
    payingAgent = cast.payingAgent
    rulesCid = cash.rulesCid
    runCid
    allocationCids
    legs = length legs
    total

-- | The paying agent's day, for N holders.
scaleWith : ScaleArgs -> Script ScaleResult
scaleWith args = do
  let n = args.holders
  Prepared {..} <- scaleAllocateOnlyWith args

  -- Settlement phase: one transaction. On a real ledger getTime is wall
  -- time, so the two stamps bracket submission-to-commit of the one
  -- SettleBatch; on the IDE ledger time is static and the difference is 0.
  t0 <- getTime
  (receiptCid, result) <- settle cast.payingAgent cash runCid allocationCids
  t1 <- getTime
  debug ("settle wall time: " <> show (convertRelTimeToMicroseconds (subTime t1 t0) / 1000) <> " ms for " <> show n <> " legs")
  Some receipt <- queryContractId cast.payingAgent receiptCid

  -- Spot checks rather than N queries: first, last and the agent.
  case (holders, legs) of
    (first :: _, firstLeg :: _) -> awaitBalance cash first firstLeg.amount
    _ -> pure ()
  case (reverse holders, reverse legs) of
    (lastH :: _, lastLeg :: _) -> awaitBalance cash lastH lastLeg.amount
    _ -> pure ()
  awaitBalance cash cast.payingAgent 1000.0
  lockedBalance cash cast.payingAgent >>= (=== 0.0)

  let r = ScaleResult with
        holders = n
        legsSettled = receipt.legsSettled
        allocationsSettled = length result.allocationSettleResults
        total = receipt.total
  r.legsSettled === n
  r.allocationsSettled === n + 1
  debug r
  pure r

-- IDE-ledger entry points, by holder count.
scale : Int -> Script ScaleResult
scale n = scaleWith (ScaleArgs Ide n None None)

scaleAllocateOnly : Int -> Script Prepared
scaleAllocateOnly n = scaleAllocateOnlyWith (ScaleArgs Ide n None None)

-- Fixed sizes for `dpm test`. Larger sizes go through `scale` or `scaleWith`
-- with an input file so the test suite stays fast.

scale_003 : Script ()
scale_003 = do
  r <- scale 3
  r.allocationsSettled === 4

scale_010 : Script ()
scale_010 = do
  r <- scale 10
  r.allocationsSettled === 11

scale_050 : Script ()
scale_050 = do
  r <- scale 50
  r.allocationsSettled === 51

-- | Sanity: the leg builder pads ids so they sort, and every recipient is a
-- distinct basic account.
scaleLegs_wellFormed : Script ()
scaleLegs_wellFormed = do
  ps <- forA [1..12] $ \i -> allocateParty ("H" <> show i)
  let legs = scaleLegs ps
  -- Five characters, not four: the scale runs reach 13,000 legs and four
  -- would stop sorting at 10,000. The literal below said four and the
  -- builder has padded to five for a while, so this asserted nothing but
  -- its own staleness.
  map (.legId) legs === [ "leg-" <> t | t <- ["00001","00002","00003","00004","00005","00006","00007","00008","00009","00010","00011","00012"] ]
  length (map (basicAccount . (.recipient)) legs) === 12
  sum (map (.amount) legs) === 1278.0

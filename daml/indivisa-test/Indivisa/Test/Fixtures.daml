-- | Shared fixture for the proofs: parties, the cash instrument, funding,
-- balances, onboarding, run creation and error text.
--
-- Everything here is test scaffolding. Nothing on the ledger depends on it.
module Indivisa.Test.Fixtures where

import DA.Exception (GeneralError(..), fromAnyException)
import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.List (chunksOf)
import DA.Optional (isNone, isSome)
import DA.Text qualified as T
import DA.TextMap qualified as TextMap
import DA.Time (milliseconds)

import Daml.Script

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.TransferInstructionV2 qualified as V2
import Splice.TokenStandard.Utils (basicAccount, toAnyContractId)
import Splice.Testing.Tokens.TestTokenV2 qualified as TestTokenV2
import Splice.Testing.Tokens.TestTokenV2.Util (tokenRulesContextKey)

import Indivisa.Types
import Indivisa.Model.Payment
import Indivisa.Model.Distribution

-- ---------------------------------------------------------------------------
-- Parties and cash
-- ---------------------------------------------------------------------------

-- | Where the parties live. The same proofs run on both; only party
-- allocation differs.
--
--   Ide       one in-memory ledger inside dpm test or the script runner
--   LocalNet  infra/localnet: five participants, one synchronizer, parties
--             allocated on the participant named for them (see the
--             participants.json passed with --participant-config)
data Topology
  = Ide
  | LocalNet
  deriving (Eq, Show)

-- | Allocate a party on the participant it belongs to. On LocalNet the name
-- carries a time tag so the proofs can be re-run against a ledger that still
-- holds earlier runs; on the IDE ledger every run starts empty.
allocateOn : Topology -> Text -> Text -> Script Party
allocateOn Ide name _ = allocateParty name
allocateOn LocalNet name participant = do
  t <- getTime
  allocatePartyOn (name <> "-" <> timeTag t) (ParticipantName participant)
  where
    timeTag t = T.implode (filter (`elem` map show [0..9]) (T.explode (show t)))

-- | Holders in the scale runs are spread round-robin over the three holder
-- participants, which is what a real coupon run looks like: many holders on
-- a few custodians' nodes.
holderParticipant : Int -> Text
holderParticipant i = case i % 3 of
  0 -> "alice"
  1 -> "bob"
  _ -> "charlie"

data Cast = Cast
  with
    topology    : Topology
    registry    : Party
    payingAgent : Party
    alice       : Party
    bob         : Party
    charlie     : Party

-- | The cash instrument as the paying agent's client sees it: the registry's
-- factory contract (disclosed, so non-signatories can exercise it), the
-- instrument id, and the registry's choice context. In production the last
-- two come from the registry's off-ledger API; TestTokenV2 wants exactly one
-- entry, its own rules contract.
data Cash = Cash
  with
    rulesCid   : ContractId TestTokenV2.TokenRules
    instrument : V2.InstrumentId
    extraArgs  : ExtraArgs
    rules      : Disclosure

setupOn : Topology -> Script (Cast, Cash)
setupOn topology = do
  registry    <- allocateOn topology "CashRegistry" "registry"
  payingAgent <- allocateOn topology "PayingAgent"  "agent"
  alice       <- allocateOn topology "Alice"        "alice"
  bob         <- allocateOn topology "Bob"          "bob"
  charlie     <- allocateOn topology "Charlie"      "charlie"
  let cast = Cast with ..

  rulesCid <- submit registry $ createCmd TestTokenV2.TokenRules with admin = registry
  Some rules <- queryDisclosure registry rulesCid
  let instrument = V2.InstrumentId with admin = registry; id = "USD"
      extraArgs = ExtraArgs with
        context = ChoiceContext with
          values = TextMap.fromList
            [(tokenRulesContextKey, AV_ContractId (toAnyContractId rulesCid))]
        meta = emptyMetadata
  pure (cast, Cash with ..)

setup : Script (Cast, Cash)
setup = setupOn Ide

-- | SIMULATED cash, minted the way the reference token mints: the registry
-- offers (TokenRules_OfferMint), the owner accepts the resulting transfer
-- instruction. Two commands from two parties, which is also why it works
-- across participants. Nothing proven depends on how the agent was funded.
fund : Cash -> Party -> Decimal -> Script ()
fund cash owner amount = do
  let registry = cash.instrument.admin
      account = basicAccount owner
  now <- requestedAt
  offer <- submit registry $ exerciseCmd cash.rulesCid TestTokenV2.TokenRules_OfferMint with
    receiver = account
    amount
    instrumentId = cash.instrument
    offeredAt = now
    receiverConfig = TestTokenV2.AccountConfig with
      admin = registry
      account
      ownerConfig = TestTokenV2.PartyConfig with canInitiate = True; mustApprove = True
      providerConfig = TestTokenV2.PartyConfig with canInitiate = False; mustApprove = False
  awaitVisible owner offer.offerCid
  result <- submit (actAs owner <> disclose cash.rules) $
    exerciseCmd (toInterfaceContractId @V2.TransferInstruction offer.offerCid)
      V2.TransferInstruction_Accept with
        actors = [owner]
        extraArgs = cash.extraArgs
  case result.output of
    V2.TransferInstructionResult_Completed _ -> pure ()
    _ -> fail "mint offer was not completed on accept"

-- | What a wallet stamps on an allocation request: its clock, now. TestTokenV2
-- requires ledger time >= requestedAt as a ledger-time bound
-- (DA.Assert.assertDeadlineExceeded), which a participant satisfies because it
-- assigns ledger time at submission.
--
-- Runner note: dpm test (static time) passes. The standalone runner against
-- the IDE ledger must be given --static-time; in its wall-clock mode getTime
-- returns wall time while ledger-time bounds are checked against a static
-- clock, so even a stamp a day in the past is "strictly before" ledger time.
-- Verified 17 Sep 2026; not a Canton behaviour.
requestedAt : Script Time
requestedAt = getTime

-- ---------------------------------------------------------------------------
-- Waiting for other participants
-- ---------------------------------------------------------------------------

-- | Participants learn of a transaction independently. A script that submits
-- on one participant and immediately acts on another races the second one:
-- on LocalNet the first attempt failed with CONTRACT_NOT_FOUND at exactly
-- that point (17 Sep). So every handoff between parties on different
-- participants waits, bounded, until the receiving party can see the
-- contract. On the IDE ledger the first poll succeeds and nothing is slower.
awaitVisible : (Template t, HasEnsure t) => Party -> ContractId t -> Script ()
awaitVisible p cid = awaitVisibleLoop p cid 200

awaitVisibleLoop : (Template t, HasEnsure t) => Party -> ContractId t -> Int -> Script ()
awaitVisibleLoop p cid 0 = fail ("contract never became visible to " <> show p <> ": " <> show cid)
awaitVisibleLoop p cid n = do
  r <- queryContractId p cid
  case r of
    Some _ -> pure ()
    None -> do
      sleep (milliseconds 100)
      awaitVisibleLoop p cid (n - 1)

-- | The same, through an interface.
awaitInterface : (Template i, HasInterfaceView i v) => Party -> ContractId i -> Script ()
awaitInterface p cid = awaitInterfaceLoop p cid 200

awaitInterfaceLoop : (Template i, HasInterfaceView i v) => Party -> ContractId i -> Int -> Script ()
awaitInterfaceLoop p cid 0 = fail ("interface contract never became visible to " <> show p <> ": " <> show cid)
awaitInterfaceLoop p cid n = do
  r <- queryInterfaceContractId p cid
  case r of
    Some _ -> pure ()
    None -> do
      sleep (milliseconds 100)
      awaitInterfaceLoop p cid (n - 1)

-- | Wait until a party's unlocked balance is the expected one, then assert
-- it. Used after a settlement, whose effects reach each holder's participant
-- a moment after the agent's submission returns.
awaitBalance : Cash -> Party -> Decimal -> Script ()
awaitBalance cash p expected = awaitBalanceLoop cash p expected 200

awaitBalanceLoop : Cash -> Party -> Decimal -> Int -> Script ()
awaitBalanceLoop cash p expected 0 = do
  actual <- balance cash p
  actual === expected
awaitBalanceLoop cash p expected n = do
  actual <- balance cash p
  if actual == expected
    then pure ()
    else do
      sleep (milliseconds 100)
      awaitBalanceLoop cash p expected (n - 1)

-- ---------------------------------------------------------------------------
-- Balances, through the V2 Holding interface
-- ---------------------------------------------------------------------------

-- | Holdings of a party's own basic account, through the V2 Holding
-- interface. That is the strong form: the query does not know our templates.
holdings : Cash -> Party -> Script [(ContractId V2.Holding, V2.HoldingView)]
holdings cash p = do
  hs <- queryInterface @V2.Holding p
  pure
    [ (cid, v)
    | (cid, Some v) <- hs
    , v.account == basicAccount p
    , v.instrumentId == cash.instrument
    ]

balance : Cash -> Party -> Script Decimal
balance cash p = do
  hs <- holdings cash p
  pure $ sum [ v.amount | (_, v) <- hs, isNone v.lock ]

lockedBalance : Cash -> Party -> Script Decimal
lockedBalance cash p = do
  hs <- holdings cash p
  pure $ sum [ v.amount | (_, v) <- hs, isSome v.lock ]

unlockedHoldingCids : Cash -> Party -> Script [ContractId V2.Holding]
unlockedHoldingCids cash p = do
  hs <- holdings cash p
  pure [ cid | (cid, v) <- hs, isNone v.lock ]

-- ---------------------------------------------------------------------------
-- Onboarding and runs
-- ---------------------------------------------------------------------------

-- | The onboarding step. Paying agent proposes, holder accepts: the one and
-- only command a holder ever submits.
onboard : Cast -> Cash -> Party -> Script (ContractId PaymentAgreement)
onboard cast cash holder = do
  proposal <- submit cast.payingAgent $ createCmd PaymentProposal with
    payingAgent = cast.payingAgent
    holder
    account = basicAccount holder
    instrument = cash.instrument
  awaitVisible holder proposal
  agreementCid <- submit holder $ exerciseCmd proposal Accept
  awaitVisible cast.payingAgent agreementCid
  pure agreementCid

-- | Onboard several holders; returns (holder, agreement) pairs.
--
-- The proposals are the paying agent's and go out in batches of fifty per
-- command (one transaction each). The acceptances are one command per
-- holder, necessarily: each holder submits its own. That is the whole cost
-- of onboarding, paid once.
onboardAll : Cast -> Cash -> [Party] -> Script [(Party, ContractId PaymentAgreement)]
onboardAll cast cash holders = do
  proposals <- fmap concat $ forA (chunksOf 50 holders) $ \batch ->
    submit cast.payingAgent $ forA batch $ \holder ->
      createCmd PaymentProposal with
        payingAgent = cast.payingAgent
        holder
        account = basicAccount holder
        instrument = cash.instrument
  agreements <- forA (zip holders proposals) $ \(holder, proposal) -> do
    awaitVisible holder proposal
    submit holder $ exerciseCmd proposal Accept
  forA_ agreements (awaitVisible cast.payingAgent)
  pure (zip holders agreements)

threeLegs : Cast -> [PaymentLeg]
threeLegs c =
  [ PaymentLeg with legId = "leg-1"; recipient = c.alice;   amount =  500.0
  , PaymentLeg with legId = "leg-2"; recipient = c.bob;     amount = 1000.0
  , PaymentLeg with legId = "leg-3"; recipient = c.charlie; amount = 1500.0
  ]

createRun : Cast -> Cash -> Text -> [PaymentLeg] -> Script (ContractId DistributionRun, DistributionRun)
createRun cast cash runId legs = do
  let run = DistributionRun with
        payingAgent = cast.payingAgent
        runId
        instrument = cash.instrument
        agentAccount = basicAccount cast.payingAgent
        legs
  cid <- submit cast.payingAgent $ createCmd run
  pure (cid, run)

-- ---------------------------------------------------------------------------
-- Error text
-- ---------------------------------------------------------------------------

-- | The message a failed submission carries. Recorded, not just matched: error
-- shapes change between Canton releases and the regression test should say
-- what it saw.
errorText : SubmitError -> Text
errorText err = case err of
  UnhandledException (Some exc) ->
    case fromAnyException exc of
      Some (GeneralError msg) -> msg
      None -> "unhandled exception of another type"
  UnhandledException None -> "unhandled exception"
  AuthorizationError msg -> "authorization error: " <> msg
  other -> show other

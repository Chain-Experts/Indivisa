-- | The paying agent's client, in Daml Script.
--
-- These are the moves the paying agent's software makes off-ledger: build the
-- allocation specifications, submit one allocation per party, then settle.
-- Nothing on the ledger calls them, which is why they live in the test
-- package. A UI or daemon reimplements exactly this sequence; the ledger side
-- (Indivisa.Model.Distribution.Run_Settle) derives the transfer legs from the
-- same Indivisa.Utils functions, so the two must agree.
module Indivisa.Test.Agent where

import Daml.Script

import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV2 qualified as V2
import Splice.TokenStandard.Utils (receiverSide, senderSide)

import Indivisa.Model.Payment
import Indivisa.Model.Distribution
import Indivisa.Utils
import Indivisa.Test.Fixtures

-- ---------------------------------------------------------------------------
-- Allocation specifications
-- ---------------------------------------------------------------------------

-- | The paying agent's side: one allocation funding every leg of the run.
-- Committed, so the agent cannot withdraw it and race the settlement.
sendAllocationSpec : V2.InstrumentId -> V2.Account -> [V2.TransferLeg] -> V2.AllocationSpecification
sendAllocationSpec instrument agentAccount legs = V2.AllocationSpecification with
  admin = instrument.admin
  authorizer = agentAccount
  transferLegSides = map senderSide legs
  settlementDeadline = None
  nextIterationFunding = None
  committed = True
  meta = emptyMetadata

-- | A holder's side: the receipt of exactly its own legs. Not committed and
-- with no funding, which is what ensureIsReceiptAllocation insists on.
receiptAllocationSpec : V2.InstrumentId -> V2.Account -> [V2.TransferLeg] -> V2.AllocationSpecification
receiptAllocationSpec instrument account legs = V2.AllocationSpecification with
  admin = instrument.admin
  authorizer = account
  transferLegSides = map receiverSide legs
  settlementDeadline = None
  nextIterationFunding = None
  committed = False
  meta = emptyMetadata

runSendAllocationSpec : DistributionRun -> V2.AllocationSpecification
runSendAllocationSpec run =
  sendAllocationSpec run.instrument run.agentAccount (runTransferLegs run)

-- | The receipt allocation for one holder: exactly the legs that pay it.
runReceiptAllocationSpec : DistributionRun -> Party -> V2.AllocationSpecification
runReceiptAllocationSpec run holder =
  receiptAllocationSpec run.instrument (holderAccount holder)
    [ leg | leg <- runTransferLegs run, leg.receiver == holderAccount holder ]

-- ---------------------------------------------------------------------------
-- Allocation phase: asynchronous, one command per allocation
-- ---------------------------------------------------------------------------

-- | The paying agent funds every leg of the run with one committed allocation.
allocateSend : Cast -> Cash -> DistributionRun -> Script (ContractId V2.Allocation)
allocateSend cast cash run = do
  now <- requestedAt
  inputHoldingCids <- unlockedHoldingCids cash cast.payingAgent
  result <- submit (actAs cast.payingAgent <> disclose cash.rules) $
    exerciseCmd (toInterfaceContractId @V2.AllocationFactory cash.rulesCid)
      V2.AllocationFactory_Allocate with
        settlement = runSettlementInfo run
        allocation = runSendAllocationSpec run
        requestedAt = now
        inputHoldingCids
        extraArgs = cash.extraArgs
        actors = [cast.payingAgent]
  case result.output of
    V2.AllocationInstructionResult_Completed cid -> pure cid
    _ -> fail "send allocation did not complete"

-- | The paying agent creates a holder's receipt allocation under the
-- agreement. Note who submits: the paying agent, alone.
allocateReceipt : Cast -> Cash -> DistributionRun -> (Party, ContractId PaymentAgreement) -> Script (ContractId V2.Allocation)
allocateReceipt cast cash run (holder, agreementCid) = do
  now <- requestedAt
  submit (actAs cast.payingAgent <> disclose cash.rules) $
    exerciseCmd agreementCid CreateReceiptAllocation with
      factoryCid = toInterfaceContractId cash.rulesCid
      choiceArg = V2.AllocationFactory_Allocate with
        settlement = runSettlementInfo run
        allocation = runReceiptAllocationSpec run holder
        requestedAt = now
        inputHoldingCids = []
        extraArgs = cash.extraArgs
        actors = [holder]

-- ---------------------------------------------------------------------------
-- Settlement phase: one transaction
-- ---------------------------------------------------------------------------

trySettle
  : Cast -> Cash -> ContractId DistributionRun -> [ContractId V2.Allocation]
  -> Script (Either SubmitError (ContractId DistributionReceipt, V2.SettlementFactory_SettleBatchResult))
trySettle cast cash runCid allocationCids =
  trySubmit (actAs cast.payingAgent <> disclose cash.rules) $
    exerciseCmd runCid Run_Settle with
      factoryCid = toInterfaceContractId cash.rulesCid
      allocationCids
      extraArgs = cash.extraArgs

settle
  : Cast -> Cash -> ContractId DistributionRun -> [ContractId V2.Allocation]
  -> Script (ContractId DistributionReceipt, V2.SettlementFactory_SettleBatchResult)
settle cast cash runCid allocationCids = do
  r <- trySettle cast cash runCid allocationCids
  case r of
    Right ok -> pure ok
    Left err -> fail ("settlement failed: " <> errorText err)

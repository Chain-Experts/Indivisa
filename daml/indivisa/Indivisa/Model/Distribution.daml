-- | A coupon run, reduced to its cash legs, and the one transaction that
-- settles it.
--
-- This module does NOT implement a token. It drives an existing V2 cash
-- instrument through SettlementFactory_SettleBatch. The bond is not modelled
-- here at all; only the cash moves.
module Indivisa.Model.Distribution where

import DA.Foldable (forA_)
import DA.List (unique)
import DA.Optional (isSome, optionalToList)

import Splice.Api.Token.MetadataV1 (ExtraArgs)
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.AllocationV2 qualified as V2

import Indivisa.Types
import Indivisa.Utils
import Indivisa.Model.Entitlement (EntitlementSchedule)

-- | The paying agent is the sole signatory and there are NO holder observers.
-- The earlier scaffold made recipients observers and the visibility proof
-- failed exactly as predicted: observers see the whole payload, so every
-- holder read every other holder's amount. Holders learn of their payment
-- from their own Holding and their own receipt allocation, never from here.
template DistributionRun
  with
    payingAgent  : Party
    runId        : Text
    instrument   : V2.InstrumentId
    agentAccount : V2.Account
    legs         : [PaymentLeg]
    schedule     : Optional (ContractId EntitlementSchedule)
      -- ^ The schedule this run pays, when there is one. The proofs run
      -- without; the product always has one. Added in 0.2.0.
    approver     : Optional Party
      -- ^ A party whose authority the settlement needs besides the agent's,
      -- typically a decentralised party whose members must confirm before
      -- anything moves. None means the agent settles alone, as before.
      -- Added in 0.4.0, last field: Smart Contract Upgrade appends.
  where
    signatory payingAgent
    observer approver

    ensure
      not (null legs)
        && all (\leg -> leg.amount > 0.0) legs
        && unique (map (.legId) legs)
        && agentAccount.owner == Some payingAgent

    -- | Settle every leg in one transaction. All or none: if any allocation is
    -- missing or unfunded the factory aborts and this choice, the receipt and
    -- every debit and credit roll back together.
    --
    -- The caller supplies the factory (disclosed by the cash registry), the
    -- allocation contract ids (the agent's send allocation plus one receipt
    -- allocation per holder) and the registry's choice context in extraArgs.
    choice Run_Settle : (ContractId DistributionReceipt, V2.SettlementFactory_SettleBatchResult)
      with
        factoryCid     : ContractId V2.SettlementFactory
        allocationCids : [ContractId V2.Allocation]
        extraArgs      : ExtraArgs
      controller runExecutors this
      do
        -- The issuer's term, enforced at the payment rather than at
        -- bookkeeping.
        --
        -- Guarding run CREATION would have been the obvious place and it is
        -- the wrong one: a client that ignored the requirement would simply
        -- create the run anyway, and nothing on the ledger would have
        -- objected. Here the requirement is checked by the party-authority
        -- rules at the moment money moves, which is the same place every
        -- other guarantee in this model lands. A run built without the
        -- approver it needed can exist; it cannot pay.
        --
        -- Only when there is a schedule to ask. The proofs and the scale
        -- tests build runs directly, with no announcement behind them, and
        -- a run with no schedule carries no issuer term to honour.
        forA_ (optionalToList schedule) $ \scheduleCid -> do
          s <- fetch scheduleCid
          assertMsg
            -- "cannot", not "may not", and the wording matches the console
            -- word for word on purpose. "May not" reads in English as a
            -- possibility as readily as a prohibition, and on a payment that
            -- turns a term of the event into a maybe. "Cannot" is also what
            -- is true here: this is the guard refusing, not advising.
            ( "this coupon cannot be released by the paying agent alone: the issuer "
                <> "required approvers on it, and this run names none" )
            (s.requiresApprovers /= Some True || isSome approver)
        result <- exercise factoryCid V2.SettlementFactory_SettleBatch with
          settlement = runSettlementInfo this
          transferLegs = runTransferLegs this
          allocations =
            [ V2.FinalizedAllocation with
                allocationCid
                extraTransferLegSides = []
                nextIterationFunding = None
            | allocationCid <- allocationCids
            ]
          actors = runExecutors this
          extraArgs
        receipt <- create DistributionReceipt with
          payingAgent
          runId
          instrument
          schedule
          legsSettled = length legs
          total = runTotal this
        pure (receipt, result)

-- | What the paying agent keeps after a successful run.
template DistributionReceipt
  with
    payingAgent : Party
    runId       : Text
    instrument  : V2.InstrumentId
    legsSettled : Int
    total       : Decimal
    schedule    : Optional (ContractId EntitlementSchedule)
      -- ^ Added in 0.2.0; upgrades append.
  where
    signatory payingAgent

-- | Total to be distributed. The legs must equal the announced distribution
-- exactly; the rounding residual becomes Indivisa.Entitlement's problem in
-- Phase 2 and it is not a detail. Off by one cent does not settle.
runTotal : DistributionRun -> Decimal
runTotal run = sum (map (.amount) run.legs)

-- | Who must authorise the settlement: the paying agent, and the approver
-- when the run names one. The same list is the choice's controllers, the
-- batch's actors and the allocations' executors, so the token standard
-- enforces it wherever the settle is attempted.
runExecutors : DistributionRun -> [Party]
runExecutors run = run.payingAgent :: optionalToList run.approver

runSettlementInfo : DistributionRun -> V2.SettlementInfo
runSettlementInfo run = settlementInfo (runExecutors run) run.runId

runTransferLegs : DistributionRun -> [V2.TransferLeg]
runTransferLegs run = map (transferLegOf run.instrument run.agentAccount) run.legs

-- | A run from a schedule: one leg per entry, in schedule order, paid in the
-- schedule's currency at the given cash registry. The run's total is the
-- schedule's total by construction, so what the paying agent funds is what
-- the token will check every leg against.
runFromSchedule : Party -> ContractId EntitlementSchedule -> EntitlementSchedule -> DistributionRun
runFromSchedule cashRegistry scheduleCid s =
  let runId = s.isin <> "/" <> show s.kind <> "/" <> show s.paymentDate
  in DistributionRun with
    payingAgent = s.payingAgent
    runId
    instrument = V2.InstrumentId with admin = cashRegistry; id = s.currency
    agentAccount = holderAccount s.payingAgent
    legs =
      [ PaymentLeg with
          legId = runId <> "#" <> show i
          recipient = e.holder
          amount = e.amount
      | (i, e) <- zip [1..length s.entries] s.entries
      ]
    schedule = Some scheduleCid
    approver = None

-- | The paying agent's record of a settlement the ledger refused. A refused
-- transaction leaves nothing behind, so the agent writes this itself after
-- catching the failure: what it tried, when, and what the ledger said. It is
-- what the paying agent's pane shows between "rejected" and "retried", and
-- it is the audit line a real paying agent would want. Added in 0.3.0.
template SettlementRejected
  with
    payingAgent   : Party
    runId         : Text
    attemptedAt   : Time
    legsRequested : Int
    reason        : Text
  where
    signatory payingAgent

-- | The V2 bridge. The ONLY module that touches Token Standard V2.
--
-- This module does NOT implement a token. It drives an existing V2 cash
-- instrument through the standard's interfaces: AllocationFactory to reserve
-- money, SettlementFactory to move it. The bond is not modelled here at all;
-- only the cash moves.
--
-- Authorisation, in one paragraph. The standard's default settlement logic
-- (settlementFactoryV2_settleBatchDefaultImpl in Splice.TokenStandard.Utils)
-- requires, for every transfer leg, an Allocation authorised by the sender's
-- account AND one authorised by the receiver's account, or the batch fails
-- with "missing authorizations". The paying agent's send allocation is its own
-- to create. The holder's receipt allocation is created by the paying agent
-- under a PaymentAgreement the holder signed once, guarded by the standard's
-- own ensureIsReceiptAllocation so the delegation can only ever authorise
-- receipts. This is the pattern the standard's authors use for the venue in
-- Splice.Testing.Apps.TradingAppV2 (TradeSettlementAgreement_CreateReceiptAllocation).
--
-- Verified against canton-network/splice tag 0.8.1, 17 September 2026.
-- Reference: CIP-0112, approved 2026-06-12.
-- https://github.com/canton-foundation/cips/blob/main/cip-0112/cip-0112.md

module Indivisa.Distribution where

import DA.Foldable (forA_)
import DA.List (unique)

import Splice.Api.Token.MetadataV1 (ExtraArgs, emptyMetadata)
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV2 qualified as V2
import Splice.TokenStandard.Utils
  ( basicAccount
  , ensureIsReceiptAllocation
  , receiverSide
  , require
  , senderSide
  )

-- ---------------------------------------------------------------------------
-- Vocabulary. Plain Daml; the V2 mapping happens below.
-- ---------------------------------------------------------------------------

-- | One holder's share of a distribution.
data PaymentLeg = PaymentLeg
  with
    legId     : Text
    recipient : Party
    amount    : Decimal
  deriving (Eq, Show, Ord)

-- ---------------------------------------------------------------------------
-- Pure builders. Used by the run's choices and by the paying agent's client
-- alike, so a script and the ledger compute the same specifications.
-- ---------------------------------------------------------------------------

-- | The settlement every allocation of a run refers to. The paying agent is
-- the sole executor: it sees every leg, which is a paying agent's job.
settlementInfo : Party -> Text -> V2.SettlementInfo
settlementInfo payingAgent runId = V2.SettlementInfo with
  executors = [payingAgent]
  id = runId
  cid = None
  meta = emptyMetadata

-- | A holder's cash account. Basic (self-custodial) accounts for now; a
-- provider (custodian) account is a Phase 2 concern and changes only this
-- function and the agreement's ensure clause.
holderAccount : Party -> V2.Account
holderAccount = basicAccount

-- | One V2 transfer leg per payment leg: paying agent to holder.
transferLegOf : V2.InstrumentId -> V2.Account -> PaymentLeg -> V2.TransferLeg
transferLegOf instrument agentAccount leg = V2.TransferLeg with
  transferLegId = leg.legId
  sender = agentAccount
  receiver = holderAccount leg.recipient
  amount = leg.amount
  instrumentId = instrument.id
  meta = emptyMetadata

-- | The paying agent's side: one allocation funding every leg of the run.
-- Committed, so the agent cannot withdraw it and race the settlement.
sendAllocationSpec : V2.InstrumentId -> V2.Account -> [V2.TransferLeg] -> V2.AllocationSpecification
sendAllocationSpec instrument agentAccount legs = V2.AllocationSpecification with
  admin = instrument.admin
  authorizer = agentAccount
  transferLegSides = map senderSide legs
  settlementDeadline = None
  nextIterationFunding = None
  committed = True
  meta = emptyMetadata

-- | A holder's side: the receipt of exactly its own legs. Not committed and
-- with no funding, which is what ensureIsReceiptAllocation insists on.
receiptAllocationSpec : V2.InstrumentId -> V2.Account -> [V2.TransferLeg] -> V2.AllocationSpecification
receiptAllocationSpec instrument account legs = V2.AllocationSpecification with
  admin = instrument.admin
  authorizer = account
  transferLegSides = map receiverSide legs
  settlementDeadline = None
  nextIterationFunding = None
  committed = False
  meta = emptyMetadata

-- ---------------------------------------------------------------------------
-- The holder's once-only consent
-- ---------------------------------------------------------------------------

-- | The onboarding step. The paying agent proposes; the holder accepts once.
-- This is the single click a holder ever makes, and the demo shows it once.
template PaymentAgreementProposal
  with
    payingAgent : Party
    holder      : Party
    account     : V2.Account
    instrument  : V2.InstrumentId
  where
    signatory payingAgent
    observer holder

    ensure account.owner == Some holder

    choice PaymentAgreementProposal_Accept : ContractId PaymentAgreement
      controller holder
      do create PaymentAgreement with ..

    choice PaymentAgreementProposal_Decline : ()
      controller holder
      do pure ()

    choice PaymentAgreementProposal_Withdraw : ()
      controller payingAgent
      do pure ()

-- | Signed once by holder and paying agent. From then on the paying agent
-- alone can create the holder's receipt allocations for this instrument.
--
-- What the holder delegates: the ability to be paid. What it does not
-- delegate: anything else. ensureIsReceiptAllocation refuses sender-side legs,
-- input holdings, committed allocations, next-iteration funding and extra
-- metadata. We add: the allocation's admin and every leg's instrument must be
-- this agreement's instrument.
template PaymentAgreement
  with
    payingAgent : Party
    holder      : Party
    account     : V2.Account
    instrument  : V2.InstrumentId
  where
    signatory payingAgent, holder

    ensure account.owner == Some holder

    -- | Create a receipt allocation for the holder. The paying agent is the
    -- controller; the holder's authority comes from its signature on this
    -- contract and reaches the factory call because actors = [holder].
    nonconsuming choice PaymentAgreement_CreateReceiptAllocation : ContractId V2.Allocation
      with
        factoryCid : ContractId V2.AllocationFactory
        choiceArg  : V2.AllocationFactory_Allocate
      controller payingAgent
      do
        ensureIsReceiptAllocation [payingAgent] holder account choiceArg
        require "allocation is for this agreement's instrument admin"
          (choiceArg.allocation.admin == instrument.admin)
        forA_ choiceArg.allocation.transferLegSides $ \side ->
          require ("transferLeg[" <> side.transferLegId <> "] is for this agreement's instrument")
            (side.instrumentId == instrument.id)
        result <- exercise factoryCid choiceArg
        case result.output of
          V2.AllocationInstructionResult_Completed allocationCid -> pure allocationCid
          V2.AllocationInstructionResult_Pending _ ->
            abort "receipt allocation came back pending; multi-step allocation is not supported"
          V2.AllocationInstructionResult_Failed ->
            abort ("receipt allocation failed: " <> show result.meta)

-- ---------------------------------------------------------------------------
-- The run
-- ---------------------------------------------------------------------------

-- | A coupon run, reduced to its cash legs.
--
-- The paying agent is the sole signatory and there are NO holder observers.
-- The earlier scaffold made recipients observers and the visibility proof
-- failed exactly as predicted: observers see the whole payload, so every
-- holder read every other holder's amount. Holders learn of their payment
-- from their own Holding and their own receipt allocation, never from here.
template DistributionRun
  with
    payingAgent  : Party
    runId        : Text
    instrument   : V2.InstrumentId
    agentAccount : V2.Account
    legs         : [PaymentLeg]
  where
    signatory payingAgent

    ensure
      not (null legs)
        && all (\l -> l.amount > 0.0) legs
        && unique (map (.legId) legs)
        && agentAccount.owner == Some payingAgent

    -- | Settle every leg in one transaction. All or none: if any allocation is
    -- missing or unfunded the factory aborts and this choice, the receipt and
    -- every debit and credit roll back together.
    --
    -- The caller supplies the factory (disclosed by the cash registry), the
    -- allocation contract ids (the agent's send allocation plus one receipt
    -- allocation per holder) and the registry's choice context in extraArgs.
    choice Run_Settle : (ContractId DistributionReceipt, V2.SettlementFactory_SettleBatchResult)
      with
        factoryCid     : ContractId V2.SettlementFactory
        allocationCids : [ContractId V2.Allocation]
        extraArgs      : ExtraArgs
      controller payingAgent
      do
        result <- exercise factoryCid V2.SettlementFactory_SettleBatch with
          settlement = settlementInfo payingAgent runId
          transferLegs = runTransferLegs this
          allocations =
            [ V2.FinalizedAllocation with
                allocationCid
                extraTransferLegSides = []
                nextIterationFunding = None
            | allocationCid <- allocationCids
            ]
          actors = [payingAgent]
          extraArgs
        receipt <- create DistributionReceipt with
          payingAgent
          runId
          instrument
          legsSettled = length legs
          total = runTotal this
        pure (receipt, result)

-- | What the paying agent keeps after a successful run.
template DistributionReceipt
  with
    payingAgent : Party
    runId       : Text
    instrument  : V2.InstrumentId
    legsSettled : Int
    total       : Decimal
  where
    signatory payingAgent

-- | Total to be distributed. The legs must equal the announced distribution
-- exactly; the rounding residual becomes Indivisa.Entitlement's problem in
-- Phase 2 and it is not a detail. Off by one cent does not settle.
runTotal : DistributionRun -> Decimal
runTotal run = sum (map (.amount) run.legs)

runSettlementInfo : DistributionRun -> V2.SettlementInfo
runSettlementInfo run = settlementInfo run.payingAgent run.runId

runTransferLegs : DistributionRun -> [V2.TransferLeg]
runTransferLegs run = map (transferLegOf run.instrument run.agentAccount) run.legs

runSendAllocationSpec : DistributionRun -> V2.AllocationSpecification
runSendAllocationSpec run = sendAllocationSpec run.instrument run.agentAccount (runTransferLegs run)

-- | The receipt allocation for one holder: exactly the legs that pay it.
runReceiptAllocationSpec : DistributionRun -> Party -> V2.AllocationSpecification
runReceiptAllocationSpec run holder =
  receiptAllocationSpec run.instrument (holderAccount holder)
    [ transferLegOf run.instrument run.agentAccount leg
    | leg <- run.legs, leg.recipient == holder
    ]
